# Email SMTP
# La app usa SMTP estándar (nodemailer), así que cambiar de proveedor es solo
# cambiar estas variables, sin tocar código.

# --- Opción Gmail (solo para pruebas locales: cae en SPAM en producción) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion
SMTP_FROM=PayDay <tu-email@gmail.com>

# --- Opción recomendada para producción: proveedor transaccional ---
# Requiere verificar un dominio propio (SPF/DKIM/DMARC) para máxima entregabilidad.
#
# Resend (https://resend.com):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx        # API key de Resend
#   SMTP_FROM=PayDay <avisos@tudominio.com>  # remitente de tu dominio verificado
#
# Brevo (https://brevo.com) — permite "single sender" sin dominio propio:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=tu-login-brevo
#   SMTP_PASS=tu-smtp-key-brevo
#   SMTP_FROM=PayDay <tu-email-verificado>
